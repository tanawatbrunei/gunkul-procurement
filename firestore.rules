rules_version = '2';

// Firestore security rules for the Gunkul Procurement app.
// All app data requires an authenticated user (email/password login).
//
// HOW TO APPLY:
//   Firebase Console → Firestore Database → Rules tab →
//   paste this whole file → Publish.
//
// Keep this file in sync with the collections used in src/ so the rules
// are version-controlled alongside the code.
service cloud.firestore {
  match /databases/{database}/documents {
    match /vendors/{docId}         { allow read, write: if request.auth != null; }
    match /items/{docId}           { allow read, write: if request.auth != null; }
    match /poLines/{docId}         { allow read, write: if request.auth != null; }
    match /meta/{docId}            { allow read, write: if request.auth != null; }
    match /importHistory/{docId}   { allow read, write: if request.auth != null; }
    match /settings/{docId}        { allow read, write: if request.auth != null; }
    match /orgChart/{docId}        { allow read, write: if request.auth != null; }
    match /staffDirectory/{docId}  { allow read, write: if request.auth != null; }
    match /trackingTabs/{tabId} {
      allow read, write: if request.auth != null;
      match /rows/{rowId}          { allow read, write: if request.auth != null; }
    }
    match /knowledgeDocs/{docId}   { allow read, write: if request.auth != null; }
    match /esgDocs/{docId}         { allow read, write: if request.auth != null; }
    match /esgTemplates/{docId}    { allow read, write: if request.auth != null; }
    match /homeProjects/{docId}    { allow read, write: if request.auth != null; }
    match /kickoffProjects/{docId} { allow read, write: if request.auth != null; }
  }
}
